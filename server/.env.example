# Copy to server/.env and fill in. Never commit the real .env.

PORT=4000
# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key: server-side only, bypasses RLS. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM ---
# "anthropic" calls Claude; "mock" returns template text so the app runs without a key.
# Defaults to "anthropic" when ANTHROPIC_API_KEY is set, otherwise "mock".
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high: lower is faster and cheaper, higher is more polished
ANTHROPIC_EFFORT=medium
# How many products to generate in parallel during batch runs
GENERATION_CONCURRENCY=5
