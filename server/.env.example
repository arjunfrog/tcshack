# Copy to server/.env and fill in. Never commit the real .env.

PORT=4000
# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key: server-side only, bypasses RLS. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM ---
# "openrouter" calls free models on OpenRouter, "anthropic" calls Claude (paid), and "mock" returns
# template text so the app runs without a key. Left empty: anthropic if ANTHROPIC_API_KEY is set,
# then openrouter if OPENROUTER_API_KEY is set, otherwise mock.
LLM_PROVIDER=

# OpenRouter: key from https://openrouter.ai/keys. Free models allow 20 requests/minute, 50/day.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional: low | medium | high for models that reason. Empty uses the model's default.
OPENROUTER_REASONING_EFFORT=

# Claude (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high: lower is faster and cheaper, higher is more polished
ANTHROPIC_EFFORT=medium

# How many products to generate in parallel during batch runs. Use 2 on free OpenRouter models.
GENERATION_CONCURRENCY=5
