# Copy to server/.env and fill in. Never commit the real .env.

PORT=4000
# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# --- Supabase (Project Settings -> API Keys) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_..., or the legacy service_role key): server-side only, bypasses RLS.
# Not the publishable key. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# --- LLM (Groq) ---
# "groq" calls Groq; "mock" returns template text so the app runs without a key.
# Defaults to "groq" when GROQ_API_KEY is set, otherwise "mock".
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
# How many products to generate in parallel during batch runs (keep low on Groq's free tier)
GENERATION_CONCURRENCY=3

# --- Anakin Wire (market data enrichment, optional) ---
ANAKIN_API_KEY=
