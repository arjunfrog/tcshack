# Copy to server/.env and fill in. Never commit the real .env.

PORT=4000
# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# --- Supabase (Project Settings -> API Keys) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_..., or the legacy service_role key): server-side only, bypasses RLS.
# Not the publishable key. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# --- Supabase Auth in the browser (Vite only exposes VITE_* variables) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- LLM ---
# "groq" or "openrouter" call free-tier models; "mock" returns template text so the app runs
# without a key. Left empty: groq if GROQ_API_KEY is set, then openrouter, otherwise mock.
LLM_PROVIDER=

# Groq: key from https://console.groq.com/keys. Free tier for gpt-oss-120b: 30 requests/minute,
# 8K tokens/minute and 200K tokens/day (roughly 40 descriptions a day per model).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning effort for gpt-oss models: low (fastest) | medium (best in the eval) | high
GROQ_REASONING_EFFORT=medium
GROQ_TEMPERATURE=0.7

# OpenRouter: key from https://openrouter.ai/keys. Free models: 20 requests/minute, 50/day.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional: low | medium | high for models that reason. Empty uses the model's default.
OPENROUTER_REASONING_EFFORT=

# How many products to generate in parallel during batch runs (keep low on free tiers)
GENERATION_CONCURRENCY=3
# One follow-up request fixes what the quality checks flag. false saves that request.
LLM_REFINE=true

# --- Anakin Wire (market data enrichment, optional) ---
ANAKIN_API_KEY=
