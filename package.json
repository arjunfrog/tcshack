{
  "name": "tcshack",
  "private": true,
  "version": "0.1.0",
  "description": "GenAI retail product description generator (TCS Technology Day)",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev -w server\" \"npm:dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "test": "npm test -w server",
    "eval": "npm run eval -w server --",
    "judge": "npm run judge -w server --",
    "data:generate": "node scripts/generate-synthetic.js",
    "db:seed": "npm run seed -w server",
    "anakin:catalog": "npm run anakin:catalog -w server --",
    "anakin:probe": "npm run anakin:probe -w server --",
    "doctor": "npm run doctor -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  }
}
